<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Post</title>
</head>
<body>
    <header>
        <h1>Create new post!</h1>
    </header>
    <main>
        <form action="/posts" method="post">

            <span>Username :</span><input type="text" id="user-name" name="username"><br><br>
            <span>Post content :</span>
            <textarea name="content" id="post-content" cols="20" rows="18">

            </textarea><br><br>
            <button>Create Post</button>
        </form>
    </main>
</body>
</html>