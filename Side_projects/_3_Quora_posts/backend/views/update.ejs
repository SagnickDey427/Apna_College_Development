<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit post</title>
</head>
<body>
    <header><h2>Edit Content</h2></header>
    <main>
        <form action="/posts/<%=post.id%>?_method=PATCH" method="post">
            <p>Post id : <%=post.id%></p>
            <p>Post name : <%=post.username%></p>
            <textarea name="content" id="edit-content" cols="20" rows="18"><%=post.content%></textarea>
            <button>Submit</button>
        </form>
    </main>
</body>
</html>